# Copy this file to `.env` and fill in your keys.
# `.env` is git-ignored — never commit real secrets.

# Required — Mistral chat model used by every graph in this folder.
# Get one at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-api-key-here

# Required for `research_assistant` (and any graph that calls `search_web`).
# Get one at: https://app.tavily.com/home
TAVILY_API_KEY=your-tavily-api-key-here

# Required for `research_assistant` — used as the Wikipedia API User-Agent
# string. Wikipedia's API policy requires a contact email so they can reach you
# if your traffic causes problems. See:
# https://meta.wikimedia.org/wiki/User-Agent_policy
EMAIL_ADDRESS=you@example.com

# Optional — enables LangSmith tracing of every graph run.
# Get one at: https://smith.langchain.com/settings
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=default
